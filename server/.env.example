# ===========================================
# CONFIGURAÇÃO DO SERVIDOR - ARQUIVO DE EXEMPLO
# ===========================================
# IMPORTANTE: Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com suas chaves reais!

# -------------------------------------------
# OBRIGATÓRIAS (o servidor não sobe sem elas)
# -------------------------------------------

# API Key do Google Gemini (para análise de vídeos com IA)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Obtenha em: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api-keys
#
# spec 008: o backend usa um ÚNICO cliente, com a chave service_role. Não
# há mais SUPABASE_ANON_KEY — o cliente anon foi removido (não só
# desaconselhado), e o servidor falha no boot sem SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret (gere uma string aleatória segura)
# Exemplo: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here

# -------------------------------------------
# OPCIONAIS (têm default no código)
# -------------------------------------------

# Porta do servidor (default: 5050)
PORT=5050

# Ambiente de execução (default: development)
NODE_ENV=development

# Origem liberada no CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Libera o cadastro público em POST /api/auth/register (default: desativado).
# Só tem efeito com o valor exato "true".
ALLOW_PUBLIC_REGISTER=true

# Cookies do YouTube no formato Netscape, para baixar vídeos que exigem login.
# Sem isso, o download desses vídeos falha.
YOUTUBE_COOKIES=

# NOTA (Fase 1): o sistema multi-agentes foi aposentado. As variáveis
# USE_MULTI_AGENTS, OPENAI_API_KEY e OPENAI_MODEL não são mais lidas
# por nenhum código e podem ser removidas do seu .env.

# Orçamento mensal de IA por GRUPO (tenant), em USD — spec 009.
# Default no código: 50. Deliberadamente permissivo: o gasto medido é de
# ~US$ 0,38/mês, então 50 é ~130x o histórico. Barra abuso sem chegar perto
# do uso real. Use 0 para DESATIVAR a verificação.
AI_MONTHLY_BUDGET_USD=50
